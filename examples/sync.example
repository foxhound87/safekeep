# .sync — configurazione di progetto per safekeep
#
# Metti questo file nella ROOT del progetto da seguire (es. ~/Code/myapp/.sync).
# Regola d'oro: una directory CON .sync è seguita; una directory SENZA .sync NON lo è.
# Il file .sync stesso viene sempre copiato nel backup (serve per ricostruire la config).
#
# SINTASSI
#   - righe che iniziano con #   → commento
#   - righe vuote                → ignorate
#   - riga nuda                  → INCLUDE: elenca cosa COPIARE   ← forma principale
#   - riga che inizia con !      → EXCLUDE (il ! va tolto dal pattern)
#   - chiavi di sezione          → name:, defaults:
#   - regole esplicite           → include: <pattern> / exclude: <pattern>
#
# ⚠️  È L'INVERSO DI GITIGNORE.
#     In un .gitignore la riga elenca i file da IGNORARE; qui elenca i file da
#     COPIARE. `*.md` in .gitignore esclude i markdown, qui `*.md` li include.
#     Il `!` vale in entrambi i file ma con il segno opposto: in .gitignore
#     `!x` re-incluso, qui `!x` ESCLUDE.
#
# Semantica last-match-wins (l'ultima regola che matcha decide):
#   defaults builtin < regole globali (config) < defaults: del progetto < regole di QUESTO file
#   → un exclude: BATTE un include: se sta SOTTO di esso
#   → un include: più in basso RI-INCLUDE ciò che un exclude: aveva escluso
#   Le righe nude condividono lista e ordine con le chiavi esplicite.
#
# SEMANTICA ALLOW-LIST (SPEC.md §4.3): un file che non matcha NESSUNA regola
# NON viene copiato. Ogni file da copiare deve matchare almeno una riga di include.
# Le directory non matchate vengono invece attraversate (si pota solo un'esclusione
# esplicita), così `*.md` raggiunge anche `docs/note.md`.
#   .sync senza nessun include → NON copia alcun file (solo .sync stesso).
#   Per l'effetto opposto, "copia tutto tranne X":
#     **              # come PRIMA riga (o nei defaults:)
#     !.git/
#     !node_modules/  # ATTENZIONE: ** sta SOPRA i builtin, quindi va
#     !.venv/         # rielencata ogni esclusione builtin (.git/ node_modules/
#     !__pycache__/   #  .venv/ __pycache__/ .DS_Store *.swp) più le tue X
#     !*.tmp

# Nome leggibile del progetto: appare nei log e nel comando `status`.
name: myapp

# Nessuna destinazione in questo file: le dest vivono SOLO in ~/.safekeep.
# Una riga `dest:` / `-dest:` ha la forma di una chiave → riga invalida
# (warning con log_level: info, errore fatale con log_level: debug).

# Regole di default di questo progetto: priorità sopra quelle globali,
# sotto le regole scritte qui sotto.
defaults: exclude: *.log
defaults: exclude: .env.local

# ------------------------------------------------------------------
# REGOLE — in quest'ordine, dall'alto verso il basso: l'ultima che
# matcha il path vince.
# ------------------------------------------------------------------

# --- Forma nuda (scelta principale): una riga = "copia questo" ---

.env                # ≡ include: .env      (e .env.example, .env.production…)
.env.*              # ≡ include: .env.*
.vault/             # ≡ include: .vault/   (la directory e tutto il suo contenuto)
*.md                # ≡ include: *.md      (README.md, docs/README.md, a/b/c.md)
docs/**             # ≡ include: docs/**   (tutto sotto docs, anche i non-markdown)

# `!` = exclude. Questo .md non va copiato: la riga STA SOTTO `*.md`,
# quindi vince (ultimo match) e lo esclude.
!docs/vendor/CHANGELOG.md

# --- Forma esplicita, del tutto equivalente ---

# Esclude le dipendenze e la cartella git (anche i builtin lo fanno già,
# ma qui è esplicito: verdict "esclusa" su una directory = sottoalbero potato).
exclude: node_modules/
exclude: .git/

# Ri-includo un file dentro una cartella altrimenti esclusa: questo include
# STA SOTTO l'exclude qui sopra, quindi vince per node_modules/LICENSE-key.txt.
include: node_modules/LICENSE-key.txt

# I file temporanei degli editor non servono a nessuno.
exclude: *.swp
exclude: *.tmp

# Nota: ancoraggio dei pattern (stile gitignore) — `*` non attraversa / dentro un segmento.
#   *.md          → README.md, docs/README.md, a/b/c.md  (basename a qualsiasi profondità)
#   docs/a.md     → con `/` interna: ancorato alla radice del progetto
#   /docs         → solo docs in cima alla radice sorgente
#   docs/**       → docs stessa e tutto il suo contenuto
#   foo/          → solo directory foo (e tutto il suo contenuto, grazie al pruning)
#   \#file        → il file letteralmente chiamato #file
#   !foo          → esclude (forma nuda); uguale a `exclude: foo`
