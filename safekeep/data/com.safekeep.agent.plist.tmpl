<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE safekeep (package data) — NON installare così com'è.

  Renderizzato da `safekeep daemon install` (sorgente unica: safekeep/data/;
  install.sh è solo un wrapper deprecato):

    __EXEC__   shim assoluto `safekeep` sul PATH (shutil.which) → ExecStart
               = `<shim> run`: nessun interprete nel template, lo shim
               sopravvive a `pipx reinstall` (una sola sorgente di verità)
    __HOME__   $HOME dell'utente — launchd NON espande `~` negli StandardOut/ErrorPath
    __PATH__   dir dove risiede fswatch + path di sistema — launchd non eredita
               il PATH di login, senza questo fswatch non viene trovato

  Validazione: plutil -lint <file>
  Caricamento: safekeep daemon start   (≡ launchctl bootstrap gui/$(id -u) <file>)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.safekeep.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>__EXEC__</string>
        <string>run</string>
    </array>

    <!-- Avvio al boot -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Tenerlo vivo: se muore, launchd lo riavvia -->
    <key>KeepAlive</key>
    <true/>

    <!-- Niente restart-loop frenetico: al massimo un riavvio ogni 30s -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Background: non compete con l'interfaccia (CPU) -->
    <key>ProcessType</key>
    <string>Background</string>

    <!-- ...né con altre operazioni di I/O -->
    <key>LowPriorityIO</key>
    <true/>

    <!-- Log del daemon: ~/.local/state/safekeep/ (SPEC.md §8) -->
    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/safekeep/out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/safekeep/err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <!-- fswatch deve trovarsi nel PATH del processo -->
        <key>PATH</key>
        <string>__PATH__</string>
        <!-- s3_secret_key_env (SPEC §18): esponi la variabile d'ambiente
             all'agent decommentando e sostituendo nome e valore:
        <key>SAFEKEEP_S3_SECRET</key>
        <string>REPLACEME</string>
        -->
    </dict>
</dict>
</plist>
